{
  "name": "BlockUSM",
  "description": "Block yourself from accessing websites, remove distracting elements from social media, and remove sites from search results.",
  "version": "1.0",
  "manifest_version": 3,
  "icons": {
    "16": "public/images/icon-16.png",
    "32": "public/images/icon-32.png",
    "48": "public/images/icon-48.png",
    "128": "public/images/icon-128.png"
  },
  "background": {
  	"service_worker": "background.js",
    "scripts": ["background.js"],
  	"type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "remove_elements.js", 
        "element_picker.js",
        "scrub_sites.js"
      ],
      "css": ["public/picker-styles.css"],
      "run_at": "document_start"
    }   
  ],
  "web_accessible_resources": [
    {
      "resources": ["public/style.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
  	"default_popup": "pages/popup.html",
    "default_icon": {
      "16": "public/images/icon-16.png",
      "32": "public/images/icon-32.png",
      "48": "public/images/icon-48.png",
      "128": "public/images/icon-128.png"
    }
  },
  "permissions": ["storage", "tabs"],
  "browser_specific_settings": {
    "gecko": {
      "id": "@blockUSM",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
